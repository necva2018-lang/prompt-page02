generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Prompt {
  id           String   @id
  title        String
  slug         String   @unique
  content      String
  coverImageUrl String  @default("")
  tags         String[] @default([])
  createdAt    String
  updatedAt    String
  publishedAt  String?
  status       String   @default("draft") // draft | published
}

model Event {
  id        String   @id
  type      String   // copy | view
  promptId  String
  createdAt String
}
